# 我们自己的版本线（0.0.x），全仓库唯一默认值。
#
# scripts/build-komari.sh 与 scripts/build-agent.sh 都 source 本文件，
# 并允许用 KOMARI_VERSION 环境变量临时覆盖。
#
# 发一个版本要同步改这几处（本文件 + 三个面向用户的字面量）：
#   scripts/version.env      ← 本文件
#   install-komari.sh        REPO_TAG（服务器安装脚本拉的 tag）
#   install-agent.sh         default_agent_version
#   install-agent.ps1        $DefaultAgentVersion
# 后两处漏改会被 ./scripts/build-agent.sh 的一致性门禁拦下。
#
# 递增规则：前端 AdminPanelBar.tsx 的 parseSemver 只取 x.y.z 三段且要求严格递增，
# 因此 0.0.4-fix1 这类 tag 永远不会被判为“可更新”，发版必须递增 patch 位。
# 详见 .trellis/spec/backend/build-and-pinning.md §1.4。
KOMARI_VERSION="${KOMARI_VERSION:-0.0.6}"
export KOMARI_VERSION
