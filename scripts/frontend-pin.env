# 上游默认主题来源（只读参考，不入库）
# 该 commit 是 komari-web 的 tag 1.4.3；我们的 0.0.1 基线即由「后端 komari tag 1.4.3 +
# 该前端」派生，此后前后端版本号均按我们自己的 0.0.x 线走。
KOMARI_WEB_REPO="https://github.com/komari-monitor/komari-web.git"
KOMARI_WEB_TAG="1.4.3"
KOMARI_WEB_COMMIT="4a74e8a81e2e4b1c3da8ad795f9523151efb6b56"

# 后台“发现新版本”检查指向的自有仓库（owner/repo）。
# 会被 scripts/sync-frontend.sh 以 VITE_KOMARI_UPDATE_REPO 传给 vite 构建；
# 源码内亦有同值默认（scripts/patches/0001-update-check-repo.patch）。
KOMARI_UPDATE_REPO="zhemed/komari"

# web/public/defaultTheme 目录树的规范化哈希（tar --sort=name --mtime=@0 | gzip -n | sha256）。
# 2026-09-16 变更：新增补丁 0006（安装命令/镜像/GitHub 链接改指 zhemed/komari），
# 哈希随产物文本变化，旧值 0dda6f17… 失效。
# 由 scripts/sync-frontend.sh 生成后回填；非空时脚本会强制校验，
# 不一致即失败——用于区分“能构建”与“可复现”。
FRONTEND_TREE_SHA256="af0bd7933feb66fd4d56d06368e8c6aeab96a3984f547d6c10ac17ae1d6e5f90"
