# 上游 komari-agent 来源与版本固定（只读参考，源码不入库）
#
# 我们不 fork agent：agent 二进制由 scripts/build-agent.sh 从下面这个 commit
# 拉取源码 + 打 scripts/patches-agent/ 下的补丁后本地构建，作为 **本仓库** release
# 的资产发布（资产名与上游一致：komari-agent-<os>-<arch>）。
# 理由与机制见 docs/MAINTAINING.md 的“agent 发行线”一节。
KOMARI_AGENT_REPO="https://github.com/komari-monitor/komari-agent.git"

# pin 到具体 commit（不要改成分支名或 latest）：浅克隆 main 时的 HEAD。
KOMARI_AGENT_COMMIT="9e532e0429cd049571e35cf344654181879b33c7"
KOMARI_AGENT_COMMIT_DATE="2026-09-15T10:15:08+08:00"

# 构建产物的版本号一律走我们自己的 0.0.x 线（scripts/version.env），
# 不沿用上游 agent 的 1.x 版本号：节点详情里显示的版本即我们的版本。
# 自更新目标仓库（-X 注入，源码默认值见补丁 0001）：
KOMARI_AGENT_UPDATE_REPO="zhemed/komari"

# 发布时使用的 Go 工具链（纯 Go、CGO_ENABLED=0，不需要 zig）。
# build-agent.sh 与本值不一致时只告警不失败——它影响的是“发布产物可复现”。
KOMARI_AGENT_GO_VERSION="go1.26.6"

# 打完补丁后源码树的规范化哈希（tar --sort=name --mtime=@0 --owner=0 --group=0
# --numeric-owner --exclude=.git | gzip -n -9 | sha256）。
# 由 scripts/build-agent.sh 计算；非空时脚本强制校验，不一致即失败——
# 用于区分“能构建”与“同一份源码”。
AGENT_SOURCE_TREE_SHA256="d28fe30d2dee18ed2a9abbfb108751cafefc3b7d329d6637e8184a9e524b2a97"
